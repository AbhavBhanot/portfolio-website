{
  "name": "ai-ml-portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "deploy:vercel": "npm run build && vercel --prod",
    "deploy:surge": "npm run build && cp dist/index.html dist/200.html && surge dist/",
    "deploy:firebase": "npm run build && firebase deploy",
    "docker:build": "docker build -t portfolio-website .",
    "docker:run": "docker run -p 80:80 portfolio-website",
    "docker:compose": "docker-compose up -d"
  },
  "dependencies": {
    "framer-motion": "^11.0.5",
    "mongodb": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^7.3.0"
  }
}
